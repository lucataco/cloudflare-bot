{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloudflare OS",
  "version": "0.1.0",
  "identifier": "com.cloudflare.workshop.desktop",
  "build": { "frontendDist": "../app" },
  "app": {
    "windows": [{ "label": "setup", "title": "Connect to your Workshop", "url": "index.html", "width": 560, "height": 380 }],
    "withGlobalTauri": true,
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"] }
}
